/* ─── TICKER ───────────────────────────────────────────────────────────── */

type TickerItem =
  | { kind: "text"; text: string; color: string }
  | { kind: "image"; src: string; alt?: string };

const SEP: TickerItem = { kind: "image", src: "/TransparentAssets/Asset 20.png", alt: "" };

const TICKER_ITEMS: TickerItem[] = [
  { kind: "text", text: "Πρότυπα Σχολεία",           color: "#0a0a0f" }, SEP,
  { kind: "text", text: "Ωνάσεια Σχολεία",           color: "#0a0a0f" }, SEP,
  { kind: "text", text: "Εκκλησιαστικά Σχολεία",      color: "#0a0a0f" }, SEP,
  { kind: "text", text: "Ανάλυση Λαθών",             color: "#0a0a0f" }, SEP,
  { kind: "text", text: "Στατιστική Ανάλυση",         color: "#0a0a0f" }, SEP,
  { kind: "text", text: "Εξατομικευμένη Διδασκαλία",  color: "#0a0a0f" }, SEP,
];

function Ticker() {
  const doubled = [...TICKER_ITEMS, ...TICKER_ITEMS];
  return (
    <div className="relative bg-[#c8ff00] overflow-hidden py-4 border-y border-black/10">
      <style>{`
        @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
        .ticker-track { animation: ticker 32s linear infinite; }
      `}</style>
      <div className="ticker-track flex items-center whitespace-nowrap">
        {doubled.map((item, i) =>
          item.kind === "text" ? (
            <span
              key={i}
              className="font-display text-base md:text-lg mx-5 flex-shrink-0"
              style={{ color: item.color }}
            >
              {item.text}
            </span>
          ) : (
            <img
              key={i}
              src={item.src}
              alt={item.alt ?? ""}
              aria-hidden={!item.alt}
              className="select-none mx-5 flex-shrink-0 h-5 md:h-6 w-auto"
            />
          ),
        )}
      </div>
    </div>
  );
}

/* ─── APP JOURNEY ──────────────────────────────────────────────────────── */

type JourneyIconName = "exam" | "answers" | "analysis" | "target" | "growth" | "parents";

const JOURNEY_STEPS: { number: string; icon: JourneyIconName; title: string; text: string; color: string }[] = [
  { number: "01", icon: "exam", title: "Προσομοίωση", text: "Διαγώνισμα σε πραγματικές συνθήκες εξέτασης.", color: "#056ef5" },
  { number: "02", icon: "answers", title: "Απαντήσεις μαθητή", text: "Καταχώριση των απαντήσεων στην πλατφόρμα.", color: "#7c00d0" },
  { number: "03", icon: "analysis", title: "Αυτόματη ανάλυση", text: "Διόρθωση και ανάλυση κάθε απάντησης.", color: "#056ef5" },
  { number: "04", icon: "target", title: "Εντοπισμός αδυναμιών", text: "Ανάδειξη κενών, λαθών και δυσκολιών.", color: "#7c00d0" },
  { number: "05", icon: "growth", title: "Στοχευμένη βελτίωση", text: "Παρέμβαση ακριβώς εκεί που χρειάζεται.", color: "#056ef5" },
  { number: "06", icon: "parents", title: "Ενημέρωση γονέα", text: "Καθαρή εικόνα προόδου και συγκεκριμένο πλάνο.", color: "#7c00d0" },
];

function JourneyIcon({ name }: { name: JourneyIconName }) {
  const common = { fill: "none", stroke: "currentColor", strokeWidth: 1.8, strokeLinecap: "round" as const, strokeLinejoin: "round" as const };

  if (name === "exam") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><path d="M14 7h16l7 7v27H14z"/><path d="M30 7v8h7M20 22h11M20 28h11M20 34h7"/><path d="m8 34 8-8 4 4-8 8-5 1z"/></svg>;
  if (name === "answers") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><rect x="10" y="7" width="28" height="34" rx="3"/><path d="M18 16h13M18 24h13M18 32h13"/><path d="m14 16 1.5 1.5L18 14m-4 10 1.5 1.5L18 22m-4 10 1.5 1.5L18 30"/></svg>;
  if (name === "analysis") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><circle cx="21" cy="21" r="11"/><path d="m29 29 11 11M17 17h8M17 22h6M17 27h4"/><circle cx="21" cy="21" r="15" opacity=".25"/></svg>;
  if (name === "target") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><circle cx="22" cy="26" r="16"/><circle cx="22" cy="26" r="10"/><circle cx="22" cy="26" r="4"/><path d="m22 26 15-15M31 11h6v6"/></svg>;
  if (name === "growth") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><path d="M8 40h33M12 35V25h7v10M23 35V18h7v17M34 35V10h7v25"/><path d="m10 20 9-7 8 3 12-10M34 6h5v5"/></svg>;
  return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><circle cx="18" cy="17" r="6"/><circle cx="32" cy="18" r="5"/><path d="M7 38c1-8 5-12 11-12s10 4 11 12M26 28c2-2 4-3 7-3 6 0 9 5 9 13"/><path d="M14 37h21"/></svg>;
}

function AppJourney() {
  return (
    <section className="relative overflow-hidden bg-[#f5f7fb] py-16 md:py-20">
      <div className="pointer-events-none absolute -left-28 top-8 h-64 w-64 rounded-full bg-brand/10 blur-3xl" />
      <div className="pointer-events-none absolute -right-28 bottom-0 h-72 w-72 rounded-full bg-[#7c00d0]/10 blur-3xl" />
      <div className="relative mx-auto max-w-7xl px-4 sm:px-6">
        <div className="mx-auto max-w-3xl text-center">
          <div className="text-[10px] font-black uppercase tracking-[.28em] text-brand">Πώς λειτουργεί η εφαρμογή</div>
          <h2 className="mt-4 font-display text-4xl leading-none text-ink md:text-6xl">Από ένα διαγώνισμα σε πραγματική εικόνα του μαθητή.</h2>
          <p className="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-ink/60 md:text-base">Μία ολοκληρωμένη διαδρομή που μετατρέπει κάθε απάντηση σε χρήσιμα δεδομένα και κάθε δεδομένο σε στοχευμένη εκπαιδευτική δράση.</p>
        </div>

        <div className="relative mt-14">
          <svg className="pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1200 520" preserveAspectRatio="none" aria-hidden="true">
            <path d="M80 120 C260 10 440 10 600 120 S950 230 1120 120 C1190 75 1190 425 1100 390 C900 310 720 500 550 390 S230 285 80 400" fill="none" stroke="#7c00d0" strokeWidth="3" strokeDasharray="10 14" opacity=".12" />
          </svg>
          <div className="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {JOURNEY_STEPS.map((step, index) => (
              <article
                key={step.number}
                className={`group relative min-h-[220px] overflow-visible rounded-[2rem] border-2 border-white p-7 shadow-[0_16px_40px_rgba(20,30,60,.09)] transition duration-300 hover:-translate-y-2 hover:-rotate-[.5deg] hover:shadow-[0_24px_55px_rgba(20,30,60,.15)] ${index % 2 === 0 ? "lg:rotate-[-.6deg]" : "lg:rotate-[.6deg]"}`}
                style={{ backgroundColor: ["#e7f1ff", "#f1e7ff", "#efffc7"][index % 3] }}
              >
                {[0, 1, 3, 4].includes(index) && (
                  <div className="absolute -right-5 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border-4 border-[#f5f7fb] bg-[#c8ff00] text-xl font-black text-ink shadow-md lg:flex">→</div>
                )}
                <div className="absolute -top-4 left-7 flex h-16 w-16 -rotate-6 items-center justify-center rounded-[1.35rem] text-white shadow-[0_12px_24px_rgba(20,30,60,.2)] transition duration-300 group-hover:rotate-3 group-hover:scale-110" style={{ backgroundColor: step.color }}>
                  <div className="h-9 w-9"><JourneyIcon name={step.icon} /></div>
                </div>
                <div className="absolute right-5 top-2 font-display text-[5.5rem] leading-none text-ink/[.06]">{step.number}</div>
                <div className="relative pt-12">
                  <div className="inline-flex rounded-full bg-white/75 px-3 py-1 text-[10px] font-black uppercase tracking-[.18em] text-ink/45">Βήμα {step.number}</div>
                  <h3 className="mt-4 max-w-[16rem] font-display text-2xl leading-[1.05] text-ink md:text-3xl">{step.title}</h3>
                  <p className="mt-4 max-w-sm text-[15px] font-medium leading-relaxed text-ink/65">{step.text}</p>
                  <div className="mt-5 flex items-center gap-2 text-[11px] font-black uppercase tracking-[.14em]" style={{ color: step.color }}>
                    <span className="h-2 w-2 rounded-full bg-current" /> Η διαδρομή
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  );
}

