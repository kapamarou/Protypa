/* ─── AUDIENCE ─────────────────────────────────────────────────────────── */

type AudienceIconName = "school" | "teacher" | "family";

function AudienceIcon({ name }: { name: AudienceIconName }) {
  const common = { fill: "none", stroke: "currentColor", strokeWidth: 1.8, strokeLinecap: "round" as const, strokeLinejoin: "round" as const };
  if (name === "school") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><path d="m5 18 19-10 19 10H5ZM9 18v22h30V18M4 40h40M15 23v11M24 23v11M33 23v11"/><path d="M21 40V29h6v11"/></svg>;
  if (name === "teacher") return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><circle cx="19" cy="14" r="6"/><path d="M8 39c1-10 4-16 11-16s10 6 11 16M30 10h13v22H31M34 17h6M34 22h6"/><path d="m27 27 9-5"/></svg>;
  return <svg viewBox="0 0 48 48" aria-hidden="true" {...common}><circle cx="16" cy="15" r="5"/><circle cx="32" cy="15" r="5"/><circle cx="24" cy="25" r="4"/><path d="M6 38c1-9 4-14 10-14 3 0 5 1 7 4M42 38c-1-9-4-14-10-14-3 0-5 1-7 4M15 40c1-7 4-11 9-11s8 4 9 11"/></svg>;
}

