                <div className={`flex h-20 w-20 items-center justify-center rounded-[1.6rem] text-white shadow-xl transition duration-300 group-hover:-rotate-6 group-hover:scale-110 ${i === 1 ? "rotate-3" : "-rotate-3"}`} style={{ backgroundColor: item.color }}>
                  <div className="h-11 w-11"><AudienceIcon name={item.icon} /></div>
                </div>
                <div className="mt-7 text-[10px] font-black uppercase tracking-[.22em]" style={{ color: item.color }}>{item.tag}</div>
                <h3 className="mt-3 font-display text-2xl leading-[1.08] text-ink md:text-3xl">{item.title}</h3>
                <ul className="mt-7 space-y-3">
