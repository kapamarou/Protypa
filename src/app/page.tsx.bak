    { tag: "Για τον εκπαιδευτικό", title: "Διδάξτε στοχευμένα, γνωρίζοντας ακριβώς πού να παρέμβετε.", icon: "teacher" as AudienceIconName, color: "#7c00d0", pale: "#f1e7ff", benefits: ["Δείτε την πορεία κάθε μαθητή", "Εντοπίστε το είδος κάθε λάθους", "Εξοικονομήστε χρόνο στην αξιολόγηση", "Σχεδιάστε το επόμενο μάθημα με δεδομένα"] },
    { tag: "Για τον γονέα", title: "Κατανοήστε την πραγματική πρόοδο πίσω από τον βαθμό.", icon: "family" as AudienceIconName, color: "#75b900", pale: "#efffc7", benefits: ["Πραγματική εικόνα με στοιχεία", "Παρακολούθηση της προόδου", "Κατανόηση δυνατών και αδύναμων σημείων", "Ενημέρωση σε κάθε βήμα"] },
