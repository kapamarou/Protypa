        <div>
          <div className="inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-[10px] font-black uppercase tracking-[.24em] text-[#c8ff00] backdrop-blur">Πέρα από τον βαθμό</div>
          <h2 className="mt-6 max-w-2xl font-display text-4xl leading-[.98] text-paper md:text-6xl">
