          <div className="relative overflow-hidden rounded-[2rem] border border-white/15 bg-white p-2 shadow-[0_35px_90px_rgba(0,0,0,.4)] sm:p-3">
            <img src="/student-insight-dashboard.png" alt="Αναλυτική εικόνα επίδοσης και εξέλιξης μαθητή στην πλατφόρμα Protupa" loading="lazy" className="aspect-[16/9] w-full rounded-[1.45rem] object-cover" />
          </div>
          <div className="absolute -bottom-5 left-5 right-5 flex items-center justify-between gap-4 rounded-2xl border border-white/20 bg-[#7c00d0]/90 px-5 py-4 text-paper shadow-xl backdrop-blur-md sm:left-10 sm:right-auto sm:min-w-[21rem]">
            <div><div className="text-[9px] font-black uppercase tracking-[.2em] text-paper/50">Protupa Insights</div><div className="mt-1 text-sm font-black">Πραγματικά δεδομένα. Στοχευμένες αποφάσεις.</div></div>
