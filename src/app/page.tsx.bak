        </div>
        <div className="mt-14 grid gap-8 lg:grid-cols-3">
          {audiences.map((item, i) => (
            <article key={item.tag} className={`group relative overflow-visible rounded-[2.25rem] border-2 border-white p-3 shadow-[0_18px_50px_rgba(20,30,60,.1)] transition duration-300 hover:-translate-y-2 ${i === 1 ? "lg:-translate-y-3 lg:hover:-translate-y-5" : ""}`} style={{ backgroundColor: item.pale }}>
              <div className="relative min-h-[450px] overflow-hidden rounded-[1.7rem] bg-white/75 p-7 backdrop-blur-sm">
                <div className="absolute -right-16 -top-16 h-44 w-44 rounded-full opacity-10" style={{ backgroundColor: item.color }} />
