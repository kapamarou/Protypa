              </div>
              <div className="absolute -bottom-4 right-8 rounded-full border-4 border-[#f5f7fb] bg-[#c8ff00] px-4 py-2 text-[10px] font-black uppercase tracking-wider text-ink shadow-md">Protupa για εσάς</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  );
}

